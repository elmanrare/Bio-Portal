{
  "scripts": {
    "start": "node server.js",
    "dev": "tailwindcss -i ./src/input.css -o ./src/output.css --watch",
    "build:netlify": "node build-netlify.cjs",
    "deploy:netlify": "npm run build:netlify && npx netlify-cli deploy --prod --dir=dist --functions=netlify/functions"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.1",
    "@tailwindcss/cli": "^4.3.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "nedb-promises": "^6.2.4",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true
  },
  "devDependencies": {
    "daisyui": "^5.7.22"
  }
}
